{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-node-snapshot && yarn workspaces foreach -A --include backend --include app --parallel -v -i run start",
    "start": "yarn workspace app start",
    "start-backend": "yarn workspace backend start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "oxlint",
    "lint:all": "oxlint",
    "new": "backstage-cli new --scope internal",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "0.36.7",
    "@backstage/e2e-test-utils": "0.1.2",
    "@backstage/eslint-plugin": "0.3.3",
    "@playwright/test": "1.64.1",
    "@types/jest": "30.0.0",
    "@typescript/typescript6": "6.0.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "node-gyp": "13.1.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "node-gyp@npm:latest": "13.1.0",
    "undici@npm:7.29.0": "7.30.2",
    "adm-zip@npm:0.6.0": "0.6.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
